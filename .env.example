# Copy this file to .env on the deployment machine.
# Do not commit the real .env file.
DOCKERHUB_NAMESPACE=your-dockerhub-username
IMAGE_TAG=sha-your-commit-sha

# The existing MongoDB service on the host; do not start a second MongoDB container.
MONGO_URI_DOCKER=mongodb://host.docker.internal:27017/expense_tracker
PORT=5000

# This is baked into the client image during CI. Use /api for same-origin production routing.
VITE_API_URL=/api
# Copy this file to .env and fill values before running docker compose or CI
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.example.mongodb.net/dbname
